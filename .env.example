APP_ENV=development
RUNTIME_ENV=local
REAL_MONEY_ENABLED=false
API_HOST=127.0.0.1
API_PORT=8080
LOG_LEVEL=info
# Tracing is optional. OTLP HTTP collector is local-only by default.
OTEL_TRACING_ENABLED=false
# Browser export requires both this server switch and the public web switch.
OTEL_BROWSER_TRACING_ENABLED=false
NEXT_PUBLIC_OTEL_BROWSER_TRACING_ENABLED=false
OTEL_SERVICE_NAME=pci-api
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACES_SAMPLER_ARG=1
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_EXPORT_TIMEOUT=5000
OTEL_SHUTDOWN_TIMEOUT_MS=6000
WEB_REFERENCE_CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/personal_commerce
# apps/api local authentication requires a private secret of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Legacy Supabase integration settings are not used by apps/api authentication.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
CREATOR_ACTOR_MAPPINGS={"supabase:provider-user-id":"creator-id"}
OPERATIONS_ACCESS_TOKEN=replace-with-at-least-16-characters
OPERATIONS_OPERATOR_ID=pilot-operator-1
# Live Provider values intentionally remain empty until Provider Qualification and Founder GO.
FOUNDER_ACTIVATION_REFERENCE=
LIVE_PROVIDER_ID=
LIVE_PROVIDER_URL=
LIVE_PROVIDER_MERCHANT_ACCOUNT=
LIVE_PROVIDER_API_CREDENTIAL=
LIVE_PROVIDER_WEBHOOK_SECRET=
LIVE_PROVIDER_ENVIRONMENT=
LIVE_PROVIDER_CURRENCY=
LIVE_PROVIDER_REGION=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_RUNTIME_ENV=local

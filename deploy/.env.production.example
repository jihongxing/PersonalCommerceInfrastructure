POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://personal_commerce:replace-with-a-long-random-password@postgres:5432/personal_commerce
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
OPERATIONS_ACCESS_TOKEN=replace-with-a-random-operations-token
OPERATIONS_OPERATOR_ID=replace-with-an-operator-id
WEB_REFERENCE_CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
OTEL_TRACING_ENABLED=false
OTEL_BROWSER_TRACING_ENABLED=false
NEXT_PUBLIC_OTEL_BROWSER_TRACING_ENABLED=false
OTEL_SERVICE_NAME=pci-api
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/json
# Set this to the private Collector URL reachable from the API container before enabling tracing.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACES_SAMPLER_ARG=1
LOG_LEVEL=info

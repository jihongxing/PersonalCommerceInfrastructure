MEMBERSHIP_FIRST_SLICE_ENABLED=false
PROGRAM_FIRST_SLICE_ENABLED=false
GOODS_FIRST_SLICE_ENABLED=false
POSTGRES_PASSWORD=replace-with-a-distinct-installer-password
MIGRATION_DATABASE_URL=postgresql://pci_ops_migration:replace-with-a-distinct-migration-password@postgres:5432/personal_commerce
DATABASE_URL=postgresql://pci_api_runtime:replace-with-a-distinct-api-password@postgres:5432/personal_commerce
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
# Creator BFF server-only runtime settings. Use the internal Compose service
# names below; these values must not be exposed through NEXT_PUBLIC_* variables.
CREATOR_BFF_DATABASE_URL=postgresql://pci_creator_bff_runtime:replace-with-a-distinct-bff-password@postgres:5432/personal_commerce
CREATOR_BFF_SESSION_SECRET=replace-with-a-random-creator-session-secret-at-least-32-bytes
CREATOR_BFF_API_BASE_URL=http://api:8080
CREATOR_BFF_ALLOWED_ORIGINS=http://localhost:3000
CREATOR_BFF_REVOCATION_SECRET=replace-with-a-random-revocation-secret-at-least-32-bytes
# Optional password recovery requires both values, an HTTPS web origin, migration 0032,
# and the API worker. Keep JWT_SECRET stable across replicas and restarts; rotating it
# invalidates pending reset links. Monitor password_reset_delivery_failed and
# password_recovery_worker_failed without logging email addresses or reset links.
PASSWORD_RESET_RESEND_API_KEY=
PASSWORD_RESET_FROM=
OPERATIONS_ACCESS_TOKEN=replace-with-a-random-operations-token
OPERATIONS_OPERATOR_ID=replace-with-an-operator-id
# Disabled by default. Use an independent server-only credential only in an authorized environment.
OPERATIONS_HUMAN_ENABLED=false
OPERATIONS_DATABASE_URL=
ADMIN_WEB_ORIGIN=http://localhost:3002
WEB_REFERENCE_CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WEB_ORIGIN=https://creator.example.test
OTEL_TRACING_ENABLED=false
OTEL_BROWSER_TRACING_ENABLED=false
NEXT_PUBLIC_OTEL_BROWSER_TRACING_ENABLED=false
OTEL_SERVICE_NAME=pci-api
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/json
# Set this to the private Collector URL reachable from the API container before enabling tracing.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACES_SAMPLER_ARG=1
LOG_LEVEL=info

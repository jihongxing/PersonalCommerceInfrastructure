FROM node:22.22.0-bookworm-slim AS build

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/admin-web/package.json apps/admin-web/package.json
RUN pnpm install --filter admin-web --frozen-lockfile
COPY apps/admin-web/ apps/admin-web/
RUN pnpm build:admin-web

FROM node:22.22.0-bookworm-slim AS runtime

ENV HOSTNAME=0.0.0.0 NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000
WORKDIR /workspace
COPY --from=build --chown=node:node /workspace/ ./
USER node
EXPOSE 3000
CMD ["node", "apps/admin-web/node_modules/next/dist/bin/next", "start", "apps/admin-web"]

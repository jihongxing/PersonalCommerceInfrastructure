FROM node:22.22.0-bookworm-slim AS build

WORKDIR /workspace
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api-mock/package.json apps/api-mock/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/web-v2/package.json apps/web-v2/package.json
RUN pnpm install --filter personal-commerce-infrastructure --frozen-lockfile

COPY . .
RUN pnpm build:api

FROM node:22.22.0-bookworm-slim AS runtime

ENV APP_ENV=production
ENV NODE_ENV=production
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/api-mock/package.json apps/api-mock/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/web-v2/package.json apps/web-v2/package.json
RUN pnpm install --filter personal-commerce-infrastructure --prod --frozen-lockfile

COPY --from=build /workspace/dist ./dist
COPY --from=build /workspace/database/migrations ./database/migrations

EXPOSE 8080
CMD ["node", "dist/apps/api/src/main.js"]

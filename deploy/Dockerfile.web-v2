FROM node:22.22.0-bookworm-slim AS build

ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
ARG NEXT_PUBLIC_OTEL_BROWSER_TRACING_ENABLED=false
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_OTEL_BROWSER_TRACING_ENABLED=${NEXT_PUBLIC_OTEL_BROWSER_TRACING_ENABLED}
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web-v2/package.json apps/web-v2/package.json
RUN pnpm install --filter web-v2 --frozen-lockfile
COPY apps/web-v2/ apps/web-v2/
RUN pnpm build:creator-web

FROM node:22.22.0-bookworm-slim AS runtime

ENV HOSTNAME=0.0.0.0
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
WORKDIR /workspace
COPY --from=build --chown=node:node /workspace/ ./
USER node
EXPOSE 3000
CMD ["node", "apps/web-v2/node_modules/next/dist/bin/next", "start", "apps/web-v2"]

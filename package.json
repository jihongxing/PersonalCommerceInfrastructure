{
  "name": "personal-commerce-infrastructure",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm dev:api",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:web": "pnpm dev:creator-web",
    "dev:creator-web": "pnpm --filter web-v2 dev",
    "build:creator-web": "pnpm --filter web-v2 build",
    "typecheck:creator-web": "pnpm --filter web-v2 typecheck",
    "test:creator-web": "pnpm --filter web-v2 exec vitest run",
    "build": "tsc -p tsconfig.build.json",
    "build:api": "tsc -p tsconfig.api.build.json",
    "build:web": "pnpm build:creator-web",
    "start": "pnpm start:api",
    "start:api": "node dist/apps/api/src/main.js",
    "db:generate": "drizzle-kit generate",
    "db:check": "pnpm build && node scripts/database/check-migrations.mjs",
    "db:migrate": "tsx scripts/database/migrate.ts",
    "db:seed:service-policy": "tsx scripts/database/import-service-policy-catalog.ts",
    "db:initialize:first-operations-account": "tsx scripts/database/initialize-first-operations-account.ts",
    "db:integration:check": "pnpm db:check && tsx scripts/database/check-integration-environment.ts",
    "check:openapi": "pnpm build && node scripts/contracts/check-openapi-compatibility.mjs",
    "smoke:deployment": "node scripts/operations/deployment-smoke.mjs",
    "test:deployment": "powershell.exe -File scripts/operations/test-production-deployment.ps1",
    "pilot-preflight": "powershell.exe -File scripts/operations/pilot-preflight.ps1",
    "pilot:activate:preflight": "powershell.exe -File scripts/operations/pilot-activation-preflight.ps1",
    "pilot:activation": "powershell.exe -File scripts/operations/pilot-activation-control.ps1",
    "deploy:external-pilot": "powershell.exe -File scripts/operations/deploy-external-pilot.ps1",
    "pilot:backup-restore": "powershell.exe -File scripts/operations/backup-restore-external-pilot.ps1",
    "web:typecheck": "pnpm typecheck:creator-web",
    "format": "prettier --write adapters applications apps contracts database modules tests scripts drizzle.config.ts eslint.config.js vitest.config.ts package.json tsconfig.json tsconfig.build.json pnpm-workspace.yaml .github/workflows/ci.yml",
    "format:check": "prettier --check adapters applications apps contracts database modules tests scripts drizzle.config.ts eslint.config.js vitest.config.ts package.json tsconfig.json tsconfig.build.json pnpm-workspace.yaml .github/workflows/ci.yml",
    "lint": "eslint adapters apps database modules tests \"applications/**/*.ts\" \"contracts/**/*.ts\" \"scripts/**/*.ts\" \"scripts/**/*.mjs\" drizzle.config.ts vitest.config.ts --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "typecheck:core": "tsc -p tsconfig.build.json --noEmit",
    "typecheck:api": "tsc -p tsconfig.api.build.json --noEmit",
    "typecheck:web-v2": "pnpm --dir apps/web-v2 exec tsc --noEmit",
    "typecheck:active": "pnpm typecheck:core && pnpm typecheck:api && pnpm typecheck:web-v2 && pnpm typecheck:admin-web",
    "typecheck:active-tests": "pnpm typecheck:active-tests:backend && pnpm typecheck:active-tests:web-bridge && pnpm typecheck:web-v2:tests && pnpm typecheck:admin-web:tests",
    "typecheck:active-tests:backend": "tsc -p tsconfig.active-tests.json --noEmit",
    "typecheck:active-tests:web-bridge": "tsc -p tsconfig.active-web-tests.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:web-v2:tests": "pnpm --dir apps/web-v2 exec tsc -p tsconfig.tests.json",
    "typecheck:historical:backend": "tsc -p tsconfig.historical.json",
    "typecheck:historical:tests": "tsc -p tsconfig.historical-tests.json --noEmit",
    "typecheck:historical": "node scripts/test/typecheck-historical.mjs",
    "test:web-bridge": "vitest run --config vitest.web-bridge.config.ts",
    "test": "vitest run",
    "test:domain": "vitest run modules",
    "test:contracts": "vitest run tests/contracts tests/integration/api-runtime.test.ts",
    "test:governance": "vitest run tests/governance",
    "test:persistence": "vitest run tests/persistence",
    "test:auth:provider": "vitest run tests/integration/supabase-auth-provider.integration.test.ts",
    "test:acceptance": "vitest run tests/acceptance",
    "test:acceptance:browser": "pnpm --filter web-v2 exec playwright test",
    "preflight": "powershell.exe -File scripts/test/preflight.ps1",
    "dev:admin-web": "pnpm --filter admin-web dev",
    "build:admin-web": "pnpm --filter admin-web build",
    "typecheck:admin-web": "pnpm --filter admin-web typecheck",
    "typecheck:admin-web:tests": "pnpm --filter admin-web typecheck:tests",
    "test:admin-web": "pnpm --filter admin-web test",
    "lint:admin-web": "pnpm --filter admin-web lint",
    "verify:admin-web": "node scripts/test/verify-admin-web.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.6",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.0.1",
    "@opentelemetry/core": "2.0.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.203.0",
    "@opentelemetry/resources": "2.0.1",
    "@opentelemetry/sdk-node": "0.203.0",
    "@opentelemetry/sdk-trace-base": "2.0.1",
    "@supabase/supabase-js": "2.112.3",
    "argon2": "0.45.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.11.3",
    "jose": "6.1.3",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "typebox": "1.0.13"
  }
}

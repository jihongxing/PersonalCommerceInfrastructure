{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/prototype/**/*.ts",
    "adapters/**/*.ts",
    "applications/**/*.ts",
    "contracts/**/*.ts",
    "database/**/*.ts",
    "modules/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "tests",
    "vitest.config.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "dist",
    "node_modules",
    "coverage",
    "adapters/auth/middleware/auth-middleware.ts",
    "adapters/transport/http/auth-routes.ts"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": "."
  },
  "include": [
    "apps/**/*.ts",
    "applications/**/*.ts",
    "contracts/**/*.ts",
    "database/**/*.ts",
    "drizzle.config.ts",
    "modules/**/*.ts",
    "scripts/**/*.ts",
    "adapters/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "apps/web-v2",
    "apps/admin-web",
    "tests/historical",
    "dist",
    "node_modules",
    "coverage"
  ]
}
